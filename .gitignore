# --- Secrets, Credentials & Environment Files ---
.env
*.env
**/.env
**/*.env
!*.env.example
!**/*.env.example
credentials.json
client_secret*.json
*.pem
*.key

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Python Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Testing, Coverage & Type Checking ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/

# --- Node.js & Frontend Artifacts ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/
.nuxt/

# --- C# / .NET Artifacts ---
[Bb]in/
[Oo]bj/
*.suo
*.user
*.userosscache
*.sln.docstates

# --- IDEs & Editor Configuration ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# --- Operating System Files ---
